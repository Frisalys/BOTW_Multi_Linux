    "LayoutMsg/SystemWindow_00.msyt": {
      "0076": {
        "contents": [
          {
            "text": "This game is compatible with the Toy-Con VR Goggles.\nDo you want to use them?"
          }
        ]
      },
      "0077": {
        "contents": [
          {
            "text": "The game will start in standard mode.\nThe VR Goggles will not be used. Is that okay?"
          }
        ]
      },
      "0078": {
        "contents": [
          {
            "text": "Use VR Goggles"
          }
        ]
      },
      "0079": {
        "contents": [
          {
            "text": "Don't use VR Goggles"
          }
        ]
      },
      "0081": {
        "contents": [
          {
            "text": "You can't use VR mode because of restrictions that have\nbeen set in Parental Controls. You can play in  standard\nmode or adjust Parental Controls in System Settings or\nthe Nintendo Switch Parental Controls app."
          }
        ]
      },
      "T_TextAdd_00": {
        "contents": [
          {
            "text": "The following information should be checked by an adult:"
          }
        ]
      },
      "T_TextAdd_01": {
        "contents": [
          {
            "text": "When using the Toy-Con VR Goggles..."
          }
        ]
      },
      "T_TextAdd_02": {
        "contents": [
          {
            "text": "Only play while seated."
          }
        ]
      },
      "T_TextAdd_03": {
        "contents": [
          {
            "text": "Be mindful of your surroundings and other people."
          }
        ]
      },
      "T_TextAdd_04": {
        "contents": [
          {
            "text": "Make sure to take regular breaks."
          }
        ]
      },
      "T_TextAdd_05": {
        "contents": [
          {
            "text": "Restrict the use of VR mode for children 6 and under."
          }
        ]
      }
    },
