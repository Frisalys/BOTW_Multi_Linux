<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Breath_of_the_Wild_Multiplayer.MVVM.View.ErrorMessageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Breath_of_the_Wild_Multiplayer.MVVM.View" xmlns:viewModel="clr-namespace:Breath_of_the_Wild_Multiplayer.MVVM.ViewModel">
  <FrameworkElement.DataContext>
    <viewModel:ErrorMessageModel />
  </FrameworkElement.DataContext>
  <Grid>
    <Button>
      <ButtonBase.Command>
        <Binding>
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">AcceptClick</Ctor>
        </Binding>
      </ButtonBase.Command>
      <FrameworkElement.Style>
        <Style>
          <Style.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
            </x:TypeExtension>
          </Style.TargetType>
          <Setter Property="Control.Template">
            <Setter.Value>
              <ControlTemplate>
                <ControlTemplate.TargetType>
                  <x:TypeExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
                  </x:TypeExtension>
                </ControlTemplate.TargetType>
                <Border Background="#00FFFFFF" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </FrameworkElement.Style>
    </Button>
    <StackPanel FrameworkElement.VerticalAlignment="Center">
      <Label Grid.Row="1" FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" Control.FontFamily="Roboto" Control.FontSize="26" Control.FontStyle="Italic" Control.Foreground="#FFFFFFFF">
        <ContentControl.Content>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Message</Ctor>
          </Binding>
        </ContentControl.Content>
      </Label>
      <Button FrameworkElement.Width="135" ContentControl.Content="Accept" Grid.Row="3" FrameworkElement.Margin="10" FrameworkElement.Style="{StaticResource ConnectToServerButton}">
        <ButtonBase.Command>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">AcceptClick</Ctor>
          </Binding>
        </ButtonBase.Command>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>