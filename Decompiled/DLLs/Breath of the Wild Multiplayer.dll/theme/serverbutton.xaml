<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ConnectionButtons">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="FrameworkElement.Width" Value="90" />
    <Setter Property="FrameworkElement.Height" Value="85" />
    <Setter Property="FrameworkElement.Margin" Value="0, 0, 0, 0" />
    <Setter Property="Control.FontSize" Value="16" />
    <Setter Property="Control.FontFamily" Value="Roboto" />
    <Setter Property="Control.FontStyle" Value="Italic" />
    <Setter Property="Control.FontWeight" Value="Bold" />
    <Setter Property="Control.Foreground" Value="#00FFFFFF" />
    <Setter Property="Control.BorderBrush" Value="#CCD9D9D9" />
    <Setter Property="Control.BorderThickness" Value="1" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Background="#00FFFFFF">
            <StackPanel>
              <ContentPresenter FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" />
              <Image FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Width="50" FrameworkElement.Height="50" Source="{TemplateBinding FrameworkElement.Tag}">
                <UIElement.Effect>
                  <DropShadowEffect ShadowDepth="0" Color="Black" Opacity="1" BlurRadius="10" />
                </UIElement.Effect>
              </Image>
              <Rectangle Shape.Fill="{TemplateBinding Control.BorderBrush}" FrameworkElement.Width="890" FrameworkElement.Height="2" FrameworkElement.Margin="0, 10, 0, 0" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Control.Foreground" Value="#FFFFFFFF" />
        <Setter Property="Control.BorderBrush" Value="#FFFFFFFF" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ConnectToServerButton">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.BorderBrush" Value="#FF626262" />
    <Setter Property="Control.Background" Value="#AA000000" />
    <Setter Property="Control.Foreground" Value="#FFFFFFFF" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Background="{TemplateBinding Control.Background}" CornerRadius="5">
            <Border FrameworkElement.Margin="2" CornerRadius="3" Background="#00FFFFFF" BorderThickness="2" BorderBrush="{TemplateBinding Control.BorderBrush}">
              <Label ContentControl.Content="{TemplateBinding ContentControl.Content}" Control.Foreground="{TemplateBinding Control.Foreground}" Control.FontSize="32" Control.FontFamily="Roboto" Control.FontStyle="Italic" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Center" />
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ButtonBase.IsPressed" Value="True">
        <Setter Property="Control.BorderBrush" Value="#FF808080" />
      </Trigger>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Control.Background" Value="#CC000000" />
      </Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter Property="Control.Foreground" Value="#FF808080" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ServerButton">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="FrameworkElement.Margin" Value="5, 3, 5, 3" />
    <Setter Property="Control.Background" Value="#99000000" />
    <Setter Property="Control.Foreground" Value="#FFD3D3D3" />
    <Setter Property="Control.BorderBrush" Value="#FF404040" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Grid>
            <Grid Panel.ZIndex="1">
              <Polygon Points="0,0 10,0 0,10" Shape.Stroke="#FFCCCCCC" Shape.Fill="#FFCCCCCC" FrameworkElement.Margin="0" />
              <Polygon Points="0,0 10,0 10,10" Shape.Stroke="#FFCCCCCC" Shape.Fill="#FFCCCCCC" FrameworkElement.Margin="0" FrameworkElement.HorizontalAlignment="Right" />
              <Polygon Points="10,0 10,10 0,10" Shape.Stroke="#FFCCCCCC" Shape.Fill="#FFCCCCCC" FrameworkElement.Margin="0" FrameworkElement.HorizontalAlignment="Right" FrameworkElement.VerticalAlignment="Bottom" />
              <Polygon Points="0,0 0,10 10,10" Shape.Stroke="#FFCCCCCC" Shape.Fill="#FFCCCCCC" FrameworkElement.Margin="0" FrameworkElement.VerticalAlignment="Bottom" />
              <FrameworkElement.Style>
                <Style>
                  <Style.TargetType>
                    <x:TypeExtension>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Grid</Ctor>
                    </x:TypeExtension>
                  </Style.TargetType>
                  <Setter Property="UIElement.Visibility" Value="Hidden" />
                  <Setter Property="FrameworkElement.Margin" Value="2" />
                  <Style.Triggers>
                    <DataTrigger Value="true">
                      <DataTrigger.Binding>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">selected</Ctor>
                        </Binding>
                      </DataTrigger.Binding>
                      <Setter Property="UIElement.Visibility" Value="Visible" />
                      <TriggerBase.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.5" From="1" To="-5" Timeline.RepeatBehavior="Forever" Timeline.AutoReverse="True" />
                          </Storyboard>
                        </BeginStoryboard>
                      </TriggerBase.EnterActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Grid>
            <Border Background="{TemplateBinding Control.Background}" CornerRadius="3">
              <Border Background="#00FFFFFF" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="2" FrameworkElement.Margin="2">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="25" />
                  </Grid.ColumnDefinitions>
                  <Grid Column="0" FrameworkElement.Margin="10,0,10,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="0.6*" />
                      <RowDefinition Height="0.4*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.ColumnSpan="2" Control.FontSize="32" Control.FontFamily="Roboto" Control.FontStyle="Italic" Control.Foreground="#FFFFFFFF" FrameworkElement.VerticalAlignment="Center" Control.Padding="0">
                      <ContentControl.Content>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Name</Ctor>
                        </Binding>
                      </ContentControl.Content>
                    </Label>
                    <Label Grid.Row="1" Control.FontSize="20" Control.FontFamily="Roboto" Control.FontStyle="Italic" Control.Foreground="#E3D146" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Left" Control.Padding="0">
                      <ContentControl.Content>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">connectedPlayersString</Ctor>
                        </Binding>
                      </ContentControl.Content>
                      <FrameworkElement.ToolTip>
                        <ToolTip>
                          <FrameworkElement.Style>
                            <Style>
                              <Style.TargetType>
                                <x:TypeExtension>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ToolTip</Ctor>
                                </x:TypeExtension>
                              </Style.TargetType>
                              <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
                              <Setter Property="UIElement.Visibility" Value="Visible" />
                              <Setter Property="Control.Template">
                                <Setter.Value>
                                  <ControlTemplate>
                                    <ControlTemplate.TargetType>
                                      <x:TypeExtension>
                                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ToolTip</Ctor>
                                      </x:TypeExtension>
                                    </ControlTemplate.TargetType>
                                    <Border Background="#CC000000" CornerRadius="10">
                                      <Border FrameworkElement.Margin="2" CornerRadius="10" Background="#00FFFFFF" BorderThickness="2" BorderBrush="#FF626262">
                                        <ItemsControl FrameworkElement.Name="playerList" Control.Background="#00FFFFFF">
                                          <ItemsControl.ItemsSource>
                                            <Binding>
                                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">playerListWithNumber</Ctor>
                                            </Binding>
                                          </ItemsControl.ItemsSource>
                                          <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                              <UniformGrid FrameworkElement.Margin="11">
                                                <UniformGrid.Columns>
                                                  <Binding>
                                                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TooltipColumnCount</Ctor>
                                                  </Binding>
                                                </UniformGrid.Columns>
                                                <FrameworkElement.LayoutTransform>
                                                  <TransformGroup>
                                                    <RotateTransform Angle="90" />
                                                    <ScaleTransform ScaleX="-1" />
                                                  </TransformGroup>
                                                </FrameworkElement.LayoutTransform>
                                              </UniformGrid>
                                            </ItemsPanelTemplate>
                                          </ItemsControl.ItemsPanel>
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                              <Label ContentControl.Content="{TemplateBinding ContentPresenter.Content}" Control.Foreground="#FFFFFFFF">
                                                <FrameworkElement.LayoutTransform>
                                                  <TransformGroup>
                                                    <RotateTransform Angle="90" />
                                                    <ScaleTransform ScaleX="-1" />
                                                  </TransformGroup>
                                                </FrameworkElement.LayoutTransform>
                                              </Label>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                      </Border>
                                    </Border>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                              <Style.Triggers>
                                <DataTrigger Value="false">
                                  <DataTrigger.Binding>
                                    <Binding>
                                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">shouldDisplayPlayersTooltip</Ctor>
                                    </Binding>
                                  </DataTrigger.Binding>
                                  <Setter Property="UIElement.Visibility" Value="Hidden" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </ToolTip>
                      </FrameworkElement.ToolTip>
                    </Label>
                    <Label Grid.Column="1" Grid.Row="1" Control.FontSize="20" Control.FontFamily="Roboto" Control.FontStyle="Italic" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Right" Control.Padding="0">
                      <ContentControl.Content>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">pingData</Ctor>
                        </Binding>
                      </ContentControl.Content>
                      <Control.Foreground>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">pingColor</Ctor>
                        </Binding>
                      </Control.Foreground>
                    </Label>
                  </Grid>
                  <Button Control.Background="#FF5C5C5C" Grid.Column="1">
                    <ButtonBase.Command>
                      <Binding>
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">changeFavoriteState</Ctor>
                      </Binding>
                    </ButtonBase.Command>
                    <Control.Template>
                      <ControlTemplate>
                        <ControlTemplate.TargetType>
                          <x:TypeExtension>
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
                          </x:TypeExtension>
                        </ControlTemplate.TargetType>
                        <Grid>
                          <Rectangle Shape.Fill="#FF5C5C5C" />
                          <Ellipse Shape.Fill="#FF000000" FrameworkElement.Width="5" FrameworkElement.Height="5" />
                        </Grid>
                      </ControlTemplate>
                    </Control.Template>
                  </Button>
                  <Ellipse Grid.Column="1" FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Width="30" FrameworkElement.Height="30" UIElement.IsHitTestVisible="False">
                    <Shape.Fill>
                      <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#FFE3D146" Offset="0.0" />
                        <GradientStop Color="#FFE3D146" Offset="0.15" />
                        <GradientStop Color="#00E3D146" Offset="0.15" />
                        <GradientStop Color="#00E3D146" Offset="0.25" />
                        <GradientStop Color="#FFE3D146" Offset="0.25" />
                        <GradientStop Color="#FFE3D146" Offset="0.4" />
                        <GradientStop Color="#44E3D146" Offset="0.4" />
                        <GradientStop Color="#00E3D146" Offset="1.0" />
                      </RadialGradientBrush>
                    </Shape.Fill>
                    <FrameworkElement.Style>
                      <Style>
                        <Style.TargetType>
                          <x:TypeExtension>
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Ellipse</Ctor>
                          </x:TypeExtension>
                        </Style.TargetType>
                        <Setter Property="UIElement.Visibility" Value="Hidden" />
                        <Style.Triggers>
                          <DataTrigger Value="true">
                            <DataTrigger.Binding>
                              <Binding>
                                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">favorite</Ctor>
                              </Binding>
                            </DataTrigger.Binding>
                            <Setter Property="UIElement.Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Ellipse>
                  <Ellipse UIElement.IsHitTestVisible="False" Grid.Column="1">
                    <FrameworkElement.Style>
                      <Style>
                        <Style.TargetType>
                          <x:TypeExtension>
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Ellipse</Ctor>
                          </x:TypeExtension>
                        </Style.TargetType>
                        <Setter Property="Shape.Stroke" Value="#FFE3D146" />
                        <Setter Property="UIElement.Visibility" Value="Hidden" />
                        <Setter Property="FrameworkElement.HorizontalAlignment" Value="Center" />
                        <Setter Property="FrameworkElement.VerticalAlignment" Value="Center" />
                        <Setter Property="FrameworkElement.Margin" Value="-200" />
                        <Style.Triggers>
                          <DataTrigger Value="true">
                            <DataTrigger.Binding>
                              <Binding>
                                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">favorite</Ctor>
                              </Binding>
                            </DataTrigger.Binding>
                            <Setter Property="UIElement.Visibility" Value="Visible" />
                            <TriggerBase.EnterActions>
                              <BeginStoryboard>
                                <Storyboard Timeline.Duration="0:0:1.5" Timeline.RepeatBehavior="Forever">
                                  <DoubleAnimation Storyboard.TargetProperty="Width" Timeline.Duration="0:0:0.8" From="10" To="40" Timeline.FillBehavior="Stop" />
                                  <DoubleAnimation Storyboard.TargetProperty="Height" Timeline.Duration="0:0:0.8" From="10" To="40" Timeline.FillBehavior="Stop" />
                                  <DoubleAnimation Storyboard.TargetProperty="Width" Timeline.Duration="0:0:0.2" Timeline.BeginTime="0:0:0.8" From="40" To="40" Timeline.FillBehavior="Stop" />
                                  <DoubleAnimation Storyboard.TargetProperty="Height" Timeline.Duration="0:0:0.2" Timeline.BeginTime="0:0:0.8" From="40" To="40" Timeline.FillBehavior="Stop" />
                                  <DoubleAnimation Storyboard.TargetProperty="Opacity" Timeline.Duration="0:0:0.2" Timeline.BeginTime="0:0:0.8" To="0" Timeline.FillBehavior="Stop" />
                                </Storyboard>
                              </BeginStoryboard>
                            </TriggerBase.EnterActions>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Ellipse>
                </Grid>
              </Border>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Control.BorderBrush" Value="#FFCCCCCC" />
        <Setter Property="Control.Foreground" Value="#FFFFFFFF" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Scroll">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ScrollViewer</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="UIElement.OpacityMask">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="Black" Offset="0" />
          <GradientStop Color="Black" Offset="1" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Value="1">
        <DataTrigger.Binding>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">scrollState</Ctor>
          </Binding>
        </DataTrigger.Binding>
        <Setter Property="UIElement.OpacityMask">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="Black" Offset="0.8" />
              <GradientStop Color="Transparent" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
      </DataTrigger>
      <DataTrigger Value="2">
        <DataTrigger.Binding>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">scrollState</Ctor>
          </Binding>
        </DataTrigger.Binding>
        <Setter Property="UIElement.OpacityMask">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="Transparent" Offset="0" />
              <GradientStop Color="Black" Offset="0.2" />
              <GradientStop Color="Black" Offset="0.8" />
              <GradientStop Color="Transparent" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
      </DataTrigger>
      <DataTrigger Value="3">
        <DataTrigger.Binding>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">scrollState</Ctor>
          </Binding>
        </DataTrigger.Binding>
        <Setter Property="UIElement.OpacityMask">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="Transparent" Offset="0" />
              <GradientStop Color="Black" Offset="0.2" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ServerContextMenu">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ContextMenu</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ContextMenu</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Background="#CC000000" CornerRadius="10">
            <Border FrameworkElement.Margin="2" CornerRadius="10" Background="#00FFFFFF" BorderThickness="2" BorderBrush="#FF626262">
              <StackPanel Panel.IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" UIElement.ClipToBounds="True" />
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ServerContextMenuItemUpper">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">MenuItem</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">MenuItem</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Name="Bd" CornerRadius="10, 10, 0, 0">
            <ContentPresenter Content="{TemplateBinding HeaderedItemsControl.Header}" FrameworkElement.Margin="10, 0, 10, 0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="MenuItem.IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="#11FFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ServerContextMenuItemLower">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">MenuItem</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">MenuItem</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Name="Bd" CornerRadius="0, 0, 10, 10">
            <ContentPresenter Content="{TemplateBinding HeaderedItemsControl.Header}" FrameworkElement.Margin="10, 0, 10, 0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="MenuItem.IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="#11FFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>