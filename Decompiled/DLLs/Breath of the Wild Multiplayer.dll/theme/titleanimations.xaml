<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="labelAnim">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Label</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Style.Triggers>
      <DataTrigger Value="true">
        <DataTrigger.Binding>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">movingRight</Ctor>
          </Binding>
        </DataTrigger.Binding>
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="-100,5,100,0" />
              <DoubleAnimation Storyboard.TargetProperty="Opacity" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="0" />
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.4" Timeline.BeginTime="0:0:0.3" Timeline.FillBehavior="Stop" From="100,5,-100,0" To="0,5,0,0" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
      </DataTrigger>
      <DataTrigger Value="true">
        <DataTrigger.Binding>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">movingLeft</Ctor>
          </Binding>
        </DataTrigger.Binding>
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="100,5,-100,0" />
              <DoubleAnimation Storyboard.TargetProperty="Opacity" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="0" />
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.4" Timeline.BeginTime="0:0:0.3" Timeline.FillBehavior="Stop" From="-100,5,100,0" To="0,5,0,0" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="buttonLabelAnim">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Label</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Style.Triggers>
      <DataTrigger Value="true">
        <DataTrigger.Binding>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">movingRight</Ctor>
          </Binding>
        </DataTrigger.Binding>
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="-50,1,50,10" />
              <DoubleAnimation Storyboard.TargetProperty="Opacity" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="0" />
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.4" Timeline.BeginTime="0:0:0.3" Timeline.FillBehavior="Stop" From="50,1,-50,10" To="0,1,0,10" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
      </DataTrigger>
      <DataTrigger Value="true">
        <DataTrigger.Binding>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">movingLeft</Ctor>
          </Binding>
        </DataTrigger.Binding>
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="50,1,-50,10" />
              <DoubleAnimation Storyboard.TargetProperty="Opacity" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="0" />
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.4" Timeline.BeginTime="0:0:0.3" Timeline.FillBehavior="Stop" From="-50,1,50,10" To="0,1,0,10" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="contentControlAnimations">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ContentControl</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Style.Triggers>
      <DataTrigger Value="true">
        <DataTrigger.Binding>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">movingRight</Ctor>
          </Binding>
        </DataTrigger.Binding>
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="-1000,0,1000,0" />
              <DoubleAnimation Storyboard.TargetProperty="Opacity" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="0" />
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.4" Timeline.BeginTime="0:0:0.3" Timeline.FillBehavior="Stop" From="1300,0,-1300,0" To="0,0,0,0" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
      </DataTrigger>
      <DataTrigger Value="true">
        <DataTrigger.Binding>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">movingLeft</Ctor>
          </Binding>
        </DataTrigger.Binding>
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="1000,0,-1000,0" />
              <DoubleAnimation Storyboard.TargetProperty="Opacity" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="0" />
              <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.4" Timeline.BeginTime="0:0:0.3" Timeline.FillBehavior="Stop" From="-1300,0,1300,0" To="0,0,0,0" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="backgroundMargin">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Rectangle</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="FrameworkElement.Margin" Value="0,0,0,0" />
    <Style.Triggers>
      <DataTrigger Value="1">
        <DataTrigger.Binding>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">viewPosition</Ctor>
          </Binding>
        </DataTrigger.Binding>
        <DataTrigger.Setters>
          <Setter Property="FrameworkElement.Margin" Value="70,0,0,0" />
        </DataTrigger.Setters>
      </DataTrigger>
      <DataTrigger Value="2">
        <DataTrigger.Binding>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">viewPosition</Ctor>
          </Binding>
        </DataTrigger.Binding>
        <Setter Property="FrameworkElement.Margin" Value="0,0,70,0" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>