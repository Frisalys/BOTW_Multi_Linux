<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:customControls="clr-namespace:Breath_of_the_Wild_Multiplayer.CustomControls">
  <Style x:Key="modifiableTextBox">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TextBox</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Foreground" Value="#FFFFFFFF" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TextBox</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Background="#88232323" FrameworkElement.Margin="15" CornerRadius="5">
            <Border Background="#00FFFFFF" BorderThickness="2" BorderBrush="#FF9A9A9A" FrameworkElement.Margin="2" CornerRadius="5">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.35*" />
                  <ColumnDefinition Width="0.65*" />
                </Grid.ColumnDefinitions>
                <Label ContentControl.Content="{TemplateBinding FrameworkElement.Tag}" FrameworkElement.VerticalAlignment="Center" Control.FontFamily="Roboto" Control.FontSize="26" Control.FontStyle="Italic" Control.Foreground="{TemplateBinding Control.Foreground}" FrameworkElement.Margin="15, 0, 0, 0" />
                <Border Background="#AA000000" Grid.Column="1" FrameworkElement.Margin="10" CornerRadius="3">
                  <Border Background="#00FFFFFF" BorderBrush="#FF404040" BorderThickness="2" FrameworkElement.Margin="2">
                    <TextBox Control.Background="#00FFFFFF" FrameworkElement.VerticalAlignment="Center" Control.FontFamily="Roboto" Control.FontSize="24" Control.FontStyle="Italic" Control.Foreground="#FFFFFFFF" Control.BorderBrush="#00FFFFFF" FrameworkElement.Margin="15, 0, 0, 0" Control.BorderThickness="0" TextBoxBase.CaretBrush="#FFFFFFFF" MaxLength="{TemplateBinding TextBox.MaxLength}" UIElement.AllowDrop="False">
                      <TextBox.Text>
                        <Binding Path="Text" Mode="TwoWay">
                          <Binding.RelativeSource>
                            <RelativeSource>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                            </RelativeSource>
                          </Binding.RelativeSource>
                        </Binding>
                      </TextBox.Text>
                    </TextBox>
                  </Border>
                </Border>
              </Grid>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter Property="Control.Foreground" Value="#FF808080" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="optionsCustomLabel">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">customControls:optionsLabel</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">customControls:optionsLabel</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Background="#88232323" FrameworkElement.Margin="15" CornerRadius="5">
            <Border Background="#00FFFFFF" BorderThickness="2" BorderBrush="#FF9A9A9A" FrameworkElement.Margin="2" CornerRadius="5">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.35*" />
                  <ColumnDefinition Width="0.65*" />
                </Grid.ColumnDefinitions>
                <Label ContentControl.Content="{TemplateBinding FrameworkElement.Tag}" FrameworkElement.VerticalAlignment="Center" Control.FontFamily="Roboto" Control.FontSize="26" Control.FontStyle="Italic" Control.Foreground="#FFFFFFFF" FrameworkElement.Margin="15, 0, 0, 0" />
                <Border Background="#AA000000" Grid.Column="1" FrameworkElement.Margin="10" CornerRadius="3">
                  <Border Background="#00FFFFFF" BorderBrush="#FF404040" BorderThickness="2" FrameworkElement.Margin="2">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.15*" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="0.15*" />
                      </Grid.ColumnDefinitions>
                      <Button ButtonBase.Command="{TemplateBinding customControls:optionsLabel.leftButton}" Control.Foreground="#FFFFFFFF" Control.Background="#FF696969">
                        <FrameworkElement.Style>
                          <Style>
                            <Style.TargetType>
                              <x:TypeExtension>
                                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
                              </x:TypeExtension>
                            </Style.TargetType>
                            <Setter Property="Control.Template">
                              <Setter.Value>
                                <ControlTemplate>
                                  <ControlTemplate.TargetType>
                                    <x:TypeExtension>
                                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
                                    </x:TypeExtension>
                                  </ControlTemplate.TargetType>
                                  <Border Background="#FF696969" CornerRadius="2" FrameworkElement.Margin="1">
                                    <Border>
                                      <Path FrameworkElement.Width="10" FrameworkElement.Height="10" Shape.Stretch="Fill" Shape.Stroke="#FFFFFFFF" Shape.Fill="#FFFFFFFF" Data="F1 M287.328,237.333 L319.344,255.818 L319.344,218.849 L287.328,237.333" />
                                    </Border>
                                  </Border>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </FrameworkElement.Style>
                      </Button>
                      <customControls:optionsLabel ContentControl.Content="{TemplateBinding ContentControl.Content}" Grid.Column="1" FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="center" movingLeft="{TemplateBinding customControls:optionsLabel.movingLeft}" movingRight="{TemplateBinding customControls:optionsLabel.movingRight}">
                        <FrameworkElement.Style>
                          <Style>
                            <Style.TargetType>
                              <x:TypeExtension>
                                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">customControls:optionsLabel</Ctor>
                              </x:TypeExtension>
                            </Style.TargetType>
                            <Setter Property="Control.Foreground" Value="#FFFFFFFF" />
                            <Setter Property="Control.FontFamily" Value="Roboto" />
                            <Setter Property="Control.FontSize" Value="22" />
                            <Setter Property="Control.FontStyle" Value="Italic" />
                            <Style.Triggers>
                              <Trigger Property="customControls:optionsLabel.movingLeft" Value="true">
                                <TriggerBase.EnterActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="100,0,-100,0" />
                                      <DoubleAnimation Storyboard.TargetProperty="Opacity" Timeline.Duration="0:0:0.31" Timeline.FillBehavior="Stop" To="0" />
                                      <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.4" Timeline.BeginTime="0:0:0.3" Timeline.FillBehavior="Stop" From="-100,0,100,0" To="0,0,0,0" />
                                    </Storyboard>
                                  </BeginStoryboard>
                                </TriggerBase.EnterActions>
                              </Trigger>
                              <Trigger Property="customControls:optionsLabel.movingRight" Value="true">
                                <TriggerBase.EnterActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.3" Timeline.FillBehavior="Stop" To="-100,0,100,0" />
                                      <DoubleAnimation Storyboard.TargetProperty="Opacity" Timeline.Duration="0:0:0.31" Timeline.FillBehavior="Stop" To="0" />
                                      <ThicknessAnimation Storyboard.TargetProperty="Margin" Timeline.Duration="0:0:0.4" Timeline.BeginTime="0:0:0.3" Timeline.FillBehavior="Stop" From="100,0,-100,0" To="0,0,0,0" />
                                    </Storyboard>
                                  </BeginStoryboard>
                                </TriggerBase.EnterActions>
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </customControls:optionsLabel>
                      <Button ContentControl.Content="&gt;" Grid.Column="2" ButtonBase.Command="{TemplateBinding customControls:optionsLabel.rightButton}">
                        <FrameworkElement.Style>
                          <Style>
                            <Style.TargetType>
                              <x:TypeExtension>
                                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
                              </x:TypeExtension>
                            </Style.TargetType>
                            <Setter Property="Control.Template">
                              <Setter.Value>
                                <ControlTemplate>
                                  <ControlTemplate.TargetType>
                                    <x:TypeExtension>
                                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
                                    </x:TypeExtension>
                                  </ControlTemplate.TargetType>
                                  <Border Background="#FF696969" CornerRadius="2" FrameworkElement.Margin="1">
                                    <Border>
                                      <Path FrameworkElement.Width="10" FrameworkElement.Height="10" Shape.Stretch="Fill" Shape.Stroke="#FFFFFFFF" Shape.Fill="#FFFFFFFF" Data="F1 M319.344,237.333 L287.328,218.849 L287.328,255.818 L319.344,237.333" />
                                    </Border>
                                  </Border>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </FrameworkElement.Style>
                      </Button>
                    </Grid>
                  </Border>
                </Border>
              </Grid>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="customButton">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Background" Value="#AA000000" />
    <Setter Property="Control.Foreground" Value="#FFFFFFFF" />
    <Setter Property="Control.BorderBrush" Value="#FF404040" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Background="#88232323" FrameworkElement.Margin="15" CornerRadius="5">
            <Border Background="#00FFFFFF" BorderThickness="2" BorderBrush="#FF9A9A9A" FrameworkElement.Margin="2" CornerRadius="5">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.35*" />
                  <ColumnDefinition Width="0.65*" />
                </Grid.ColumnDefinitions>
                <Label ContentControl.Content="{TemplateBinding FrameworkElement.Tag}" FrameworkElement.VerticalAlignment="Center" Control.FontFamily="Roboto" Control.FontSize="26" Control.FontStyle="Italic" Control.Foreground="#FFFFFFFF" FrameworkElement.Margin="15, 0, 0, 0" UIElement.IsHitTestVisible="False" />
                <Border Background="{TemplateBinding Control.Background}" Grid.Column="1" FrameworkElement.Margin="10" CornerRadius="3">
                  <Border Background="#00FFFFFF" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="2" FrameworkElement.Margin="2">
                    <Label ContentControl.Content="{TemplateBinding ContentControl.Content}" Control.Background="#00FFFFFF" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Center" Control.FontFamily="Roboto" Control.FontSize="22" Control.FontStyle="Italic" Control.Foreground="#FFFFFFFF" Control.BorderBrush="#00FFFFFF" Control.BorderThickness="0" />
                  </Border>
                </Border>
              </Grid>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ButtonBase.IsPressed" Value="True">
        <Setter Property="Control.BorderBrush" Value="#FF808080" />
      </Trigger>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Control.Background" Value="#CC000000" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="creditsLabel">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Label</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.FontFamily" Value="Roboto" />
    <Setter Property="Control.FontStyle" Value="Italic" />
    <Setter Property="Control.FontSize" Value="21" />
    <Setter Property="Control.Foreground" Value="#FFFFFFFF" />
    <Setter Property="UIElement.Effect">
      <Setter.Value>
        <DropShadowEffect ShadowDepth="0" Color="Black" Opacity="1" BlurRadius="20" />
      </Setter.Value>
    </Setter>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Label</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <DockPanel>
            <ContentPresenter FrameworkElement.VerticalAlignment="Center" />
            <Label FrameworkElement.HorizontalAlignment="Right" ContentControl.Content="{TemplateBinding FrameworkElement.Tag}" FrameworkElement.VerticalAlignment="Center" Control.FontFamily="Roboto" Control.FontStyle="Italic" Control.FontSize="21" Control.Foreground="#FFFFFFFF" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>